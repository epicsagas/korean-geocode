{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "고가용성 하이브리드 Geocoding 서비스 - Google Maps, Kakao Local, vWorld API 통합\n\n## 주요 특징\n- 🌏 하이브리드 전략: 비용 최적화 + 고가용성\n- 🔄 Smart Router: 한글/영문 자동 감지 및 최적 Provider 선택\n- ⚡ Circuit Breaker: 장애 격리 및 자동 복구\n- 📊 Rate Limiting: 일일 쿼터 관리\n- 🗺️ WGS84 통일: 모든 좌표계를 WGS84로 정규화\n\n## Provider 우선순위\n- 한글 주소: Kakao → vWorld → Google\n- 영문 주소: Google → Kakao",
        "title": "GeoCoding Hybrid API",
        "contact": {
            "name": "API Support",
            "url": "https://github.com/epicsagas/korean-geocode/issues"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "서버 및 모든 Provider의 상태를 확인합니다. Kubernetes Liveness/Readiness Probe에 사용할 수 있습니다.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "서버 상태 확인",
                "responses": {
                    "200": {
                        "description": "서버 정상 동작",
                        "schema": {
                            "$ref": "#/definitions/http.Response"
                        }
                    }
                }
            }
        },
        "/v1/geocode": {
            "get": {
                "description": "입력된 주소를 위도/경도 좌표로 변환합니다. 주소 패턴에 따라 최적의 Provider가 자동으로 선택되며, 실패 시 자동으로 다른 Provider로 Failover됩니다.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geocoding"
                ],
                "summary": "주소를 좌표로 변환",
                "parameters": [
                    {
                        "type": "string",
                        "example": "서울특별시 강남구 테헤란로 152",
                        "description": "검색할 주소 (한글 또는 영문)",
                        "name": "q",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "성공적으로 좌표를 반환",
                        "schema": {
                            "$ref": "#/definitions/http.Response"
                        }
                    },
                    "400": {
                        "description": "잘못된 요청 (쿼리 파라미터 누락)",
                        "schema": {
                            "$ref": "#/definitions/http.Response"
                        }
                    },
                    "500": {
                        "description": "서버 내부 오류 또는 모든 Provider 실패",
                        "schema": {
                            "$ref": "#/definitions/http.Response"
                        }
                    },
                    "503": {
                        "description": "서비스 일시 중단 (Circuit Breaker Open)",
                        "schema": {
                            "$ref": "#/definitions/http.Response"
                        }
                    }
                }
            }
        },
        "/v1/quota": {
            "get": {
                "description": "Provider별 현재 쿼터 사용량을 조회합니다",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "quota"
                ],
                "summary": "쿼터 조회",
                "parameters": [
                    {
                        "type": "string",
                        "description": "특정 Provider 조회 (vworld, kakao, naver, google)",
                        "name": "provider",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.QuotaResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.QuotaResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.ErrorInfo": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "details": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "http.ProviderQuota": {
            "type": "object",
            "properties": {
                "provider": {
                    "type": "string"
                },
                "quota": {
                    "type": "integer"
                },
                "remaining": {
                    "type": "integer"
                },
                "usage": {
                    "type": "integer"
                }
            }
        },
        "http.QuotaResponse": {
            "type": "object",
            "properties": {
                "quotas": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/http.ProviderQuota"
                    }
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "http.Response": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "$ref": "#/definitions/http.ErrorInfo"
                },
                "meta": {},
                "success": {
                    "type": "boolean"
                }
            }
        }
    },
    "tags": [
        {
            "description": "주소-좌표 변환 API",
            "name": "geocoding"
        },
        {
            "description": "서버 상태 확인",
            "name": "health"
        }
    ]
}