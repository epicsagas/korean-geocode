# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Kakao Local API Configuration
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# vWorld API Configuration
VWORLD_API_KEY=your_vworld_api_key_here

# Naver Cloud Platform Maps API Configuration
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Server Configuration
SERVER_PORT=8080
SERVER_TIMEOUT=5s

# Circuit Breaker Configuration
CIRCUIT_BREAKER_MAX_REQUESTS=10
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60s

# Rate Limiting (Daily Quotas)
VWORLD_DAILY_QUOTA=100000
KAKAO_DAILY_QUOTA=300000
NAVER_DAILY_QUOTA=100000
GOOGLE_MONTHLY_CREDIT=200

# Provider Order (comma-separated, default: vworld,kakao,naver,google for Korean)
KOREAN_PROVIDER_ORDER=vworld,kakao,naver,google
GLOBAL_PROVIDER_ORDER=google,naver,kakao

# Redis Configuration (for rate limiting, optional - uses SQLite if not set)
# Leave empty to use SQLite instead of Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
